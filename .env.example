# Copier ce fichier en .env puis adapter.

PORT=3000

# On se connecte normalement via le lien d'invitation, sans rien taper.
# Ce code ne sert que de secours si le lien est perdu. Laisser vide pour le desactiver.
APP_PIN=1234

# Les deux occupants. Format: id:Prenom:plateforme
# La plateforme (android | ios) sert a reconnaitre automatiquement qui ouvre l'app.
USERS=jerome:Jerome:android,laurine:Laurine:ios

# Cles VAPID pour le Web Push -> genere avec: npm run keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tonadresse@example.com

# Jour du menage complet (0 = dimanche, 1 = lundi ... 6 = samedi)
MENAGE_DAY=6

# Duree d'un cycle de machine a laver, en minutes
MACHINE_MINUTES=120

# Delai avant de considerer le linge etendu comme sec, en heures
LINGE_SEC_HOURS=6

# Fuseau horaire utilise par le planificateur
TZ=Europe/Paris
